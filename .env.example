# 复制为 .env 并填写
# 聚类系统仓库路径（形态识别引擎，本地已部署则直接指到仓库根目录）
CLUSTER_REPO_PATH=C:\Users\Administrator\Desktop\stock-api-master\stock-api-master
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/510f9bf9-ed9c-4487-9be2-e058e9ee6d31
